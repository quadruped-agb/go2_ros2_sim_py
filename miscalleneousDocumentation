Now I am back to lidar. This is the script I use to check:
cat << 'EOF' > /tmp/check_lidar_fov.py
#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import PointCloud2
import sensor_msgs_py.point_cloud2 as pc2
import numpy as np

TOPIC = '/robot1/points/points_timed'

class FovChecker(Node):
    def __init__(self):
        super().__init__('fov_checker')
        self.got_msg = False
        self.sub = self.create_subscription(PointCloud2, TOPIC, self.cb, 10)

    def cb(self, msg):
        points = pc2.read_points(msg, field_names=('x', 'y', 'z'), skip_nans=True)
        if points.shape[0] == 0:
            self.get_logger().warn("Received empty point cloud")
            return

        x, y, z = points['x'], points['y'], points['z']
        r = np.sqrt(x**2 + y**2 + z**2)
        azimuth = np.mod(np.degrees(np.arctan2(y, x)), 360.0)
        elevation = np.degrees(np.arcsin(np.clip(z / r, -1.0, 1.0)))

        print(f"\n=== Scan Summary ===")
        print(f"Total points in this scan: {points.shape[0]}")
        print(f"Range: min={r.min():.2f}m  max={r.max():.2f}m  mean={r.mean():.2f}m")

        print(f"\n=== Horizontal FOV (Azimuth) ===")
        print(f"Min: {azimuth.min():.2f}  Max: {azimuth.max():.2f}")
        hist, _ = np.histogram(azimuth, bins=36, range=(0, 360))
        covered_bins = np.sum(hist > 0)
        print(f"Angular coverage: {covered_bins}/36 sectors (~{covered_bins*10} deg of 360 deg represented)")

        print(f"\n=== Vertical FOV (Elevation) ===")
        print(f"Min: {elevation.min():.2f}  Max: {elevation.max():.2f}")
        print(f"(Real Mid360 spec: -7 to +52 deg)")

        print(f"\n=== Points/sec estimate ===")
        print(f"{points.shape[0]} points x 10Hz scan rate = {points.shape[0] * 10} pts/sec")
        print(f"(Real Mid360 spec: ~200,000 pts/sec)")

        self.got_msg = True

def main():
    rclpy.init()
    node = FovChecker()
    start = node.get_clock().now()
    while rclpy.ok() and not node.got_msg:
        rclpy.spin_once(node, timeout_sec=1.0)
        if (node.get_clock().now() - start).nanoseconds / 1e9 > 10:
            print(f"Timed out waiting for message on {TOPIC}")
            break
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
EOF
